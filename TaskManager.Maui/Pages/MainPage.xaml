<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KMA.TaskManager.Maui.ViewModels"
             xmlns:projects="clr-namespace:KMA.TaskManager.Services.DTOModels.Projects;assembly=TaskManager.DTOModels"
             x:Class="KMA.TaskManager.Maui.Pages.MainPage"
             x:DataType="viewmodels:MainPageViewModel"
             Title="Мої Проєкти">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Додати" 
                     Command="{Binding GoToCreateCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto, Auto, *">

        <SearchBar Grid.Row="0" 
                   Text="{Binding SearchText}" 
                   Placeholder="Пошук за назвою..." 
                   Margin="10,5"/>

        <HorizontalStackLayout Grid.Row="1" Spacing="10" Margin="15,0,15,10">
            <Label Text="Сортувати за:" VerticalOptions="Center" FontAttributes="Bold"/>
            <Picker ItemsSource="{Binding SortOptions}" 
                    SelectedItem="{Binding SelectedSortOption}" 
                    VerticalOptions="Center"
                    WidthRequest="200"/>
        </HorizontalStackLayout>

        <CollectionView Grid.Row="2" 
                        ItemsSource="{Binding Projects}" 
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="projects:ProjectListDTO">
                    <Frame Margin="10,5" 
                           Padding="15" 
                           CornerRadius="8"
                           HasShadow="True">

                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainPageViewModel}}, Path=GoToDetailsCommand}"
                                        CommandParameter="{Binding Id}" />
                                </VerticalStackLayout.GestureRecognizers>

                                <Label Text="{Binding Name}" 
                                       FontSize="18" 
                                       FontAttributes="Bold" />
                                <Label Text="{Binding Progress, StringFormat='Прогрес: {0:F0}%'}" 
                                       FontSize="14" 
                                       TextColor="Gray" />
                            </VerticalStackLayout>

                            <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                                <Button Text="Редаг." 
                                        FontSize="12"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainPageViewModel}}, Path=GoToEditCommand}"
                                        CommandParameter="{Binding Id}" />

                                <Button Text="Видалити" 
                                        FontSize="12"
                                        BackgroundColor="Crimson"
                                        TextColor="White"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainPageViewModel}}, Path=DeleteProjectCommand}"
                                        CommandParameter="{Binding Id}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>