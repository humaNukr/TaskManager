<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:KMA.TaskManager.Maui.ViewModels"
    x:Class="KMA.TaskManager.Maui.Pages.TaskDetails"
    x:DataType="vm:TaskDetailsViewModel"
    BackgroundColor="{StaticResource PageBackground}"
    Title="Деталі завдання">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Frame BackgroundColor="{StaticResource CardBackground}" 
                   BorderColor="{StaticResource BorderColor}" 
                   CornerRadius="16" HasShadow="True" Padding="20">
                <VerticalStackLayout Spacing="15">

                    <Label Text="{Binding CurrentTask.Name}" 
                           FontSize="24" FontAttributes="Bold" 
                           TextColor="{StaticResource TextPrimary}" 
                           LineBreakMode="WordWrap" />

                    <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" />

                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="Статус:" TextColor="{StaticResource TextSecondary}" FontAttributes="Bold" VerticalOptions="Center" />

                        <Frame Padding="15,6" CornerRadius="16" BackgroundColor="#F9F9F9" BorderColor="{StaticResource BorderColor}" HasShadow="False">
                            <Label FontSize="13" FontAttributes="Bold" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding CurrentTask.IsCompleted}" Value="True">
                                        <Setter Property="Text" Value="Завершено ✅" />
                                        <Setter Property="TextColor" Value="{StaticResource SuccessColor}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding CurrentTask.IsCompleted}" Value="False">
                                        <Setter Property="Text" Value="В процесі ⏳" />
                                        <Setter Property="TextColor" Value="{StaticResource ThemeGoldenrod}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Frame>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="{StaticResource CardBackground}" 
                   BorderColor="{StaticResource BorderColor}" 
                   CornerRadius="16" HasShadow="True" Padding="20">
                <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, Auto" RowSpacing="15">

                    <Label Grid.Row="0" Grid.Column="0" Text="📌 Пріоритет:" TextColor="{StaticResource TextSecondary}" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label Grid.Row="0" Grid.Column="1" 
                           Text="{Binding CurrentTask.Priority, Converter={StaticResource EnumToDisplayNameConverter}}" 
                           FontAttributes="Bold" FontSize="16" HorizontalOptions="End" VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding CurrentTask.Priority}" Value="Critical">
                                <Setter Property="TextColor" Value="{StaticResource DangerColor}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding CurrentTask.Priority}" Value="High">
                                <Setter Property="TextColor" Value="{StaticResource ThemeDarkPink}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding CurrentTask.Priority}" Value="Medium">
                                <Setter Property="TextColor" Value="{StaticResource ThemeCyan}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding CurrentTask.Priority}" Value="Low">
                                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <Label Grid.Row="1" Grid.Column="0" Text="📅 Виконати до:" TextColor="{StaticResource TextSecondary}" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding CurrentTask.DueDate, StringFormat='{0:dd MMMM yyyy}'}" 
                           TextColor="{StaticResource TextPrimary}" FontAttributes="Bold" HorizontalOptions="End" VerticalOptions="Center"/>

                    <Label Grid.Row="2" Grid.Column="0" Text="⏱️ Ліміт часу:" TextColor="{StaticResource TextSecondary}" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label Grid.Row="2" Grid.Column="1" FontSize="14" FontAttributes="Bold" HorizontalOptions="End" VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding CurrentTask.IsOverdue}" Value="True">
                                <Setter Property="Text" Value="Прострочено ⚠️" />
                                <Setter Property="TextColor" Value="{StaticResource DangerColor}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding CurrentTask.IsOverdue}" Value="False">
                                <Setter Property="Text" Value="В межах норми 🟢" />
                                <Setter Property="TextColor" Value="{StaticResource SuccessColor}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Grid>
            </Frame>

            <Frame BackgroundColor="{StaticResource CardBackground}" 
                   BorderColor="{StaticResource BorderColor}" 
                   CornerRadius="16" HasShadow="True" Padding="20">
                <Grid ColumnDefinitions="4, *">
                    <BoxView Grid.Column="0" Color="{StaticResource ThemeGoldenrod}" CornerRadius="2" VerticalOptions="Fill" />

                    <VerticalStackLayout Grid.Column="1" Spacing="8" Padding="15,0,0,0">
                        <Label Text="ОПИС ЗАВДАННЯ" FontSize="12" CharacterSpacing="1.5" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                        <Label Text="{Binding CurrentTask.Description}" FontSize="16" TextColor="{StaticResource TextPrimary}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>
            </Frame>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0, 10, 0, 20">
                <Button Grid.Column="0" Text="Редагувати" Command="{Binding EditTaskCommand}" 
                        BackgroundColor="{StaticResource ThemeCyan}" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="50"/>

                <Button Grid.Column="1" Text="Видалити" Command="{Binding DeleteTaskCommand}" 
                        BackgroundColor="{StaticResource DangerColor}" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="50"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>