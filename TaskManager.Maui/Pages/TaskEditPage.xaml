<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:KMA.TaskManager.Maui.ViewModels"
    x:Class="KMA.TaskManager.Maui.Pages.TaskEditPage"
    x:DataType="vm:TaskEditViewModel"
    Title="Редагування завдання"
    BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Редагувати завдання" 
                   FontSize="24" FontAttributes="Bold" 
                   TextColor="{StaticResource TextPrimary}"
                   HorizontalOptions="Center" 
                   Margin="0,0,0,10" />

            <Frame BackgroundColor="{StaticResource CardBackground}" 
                   BorderColor="{StaticResource BorderColor}" 
                   CornerRadius="16" HasShadow="True" Padding="20">
                <VerticalStackLayout Spacing="15">

                    <Label Text="📝 ОСНОВНА ІНФОРМАЦІЯ" FontSize="12" CharacterSpacing="1" FontAttributes="Bold" TextColor="{StaticResource ThemeGoldenrod}" Margin="0,0,0,5" />

                    <Label Text="Назва завдання" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                    <Frame Padding="10,0" BorderColor="{StaticResource BorderColor}" CornerRadius="8" BackgroundColor="#F9F9F9" HasShadow="False">
                        <Entry Text="{Binding Name}" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent" ClearButtonVisibility="WhileEditing" />
                    </Frame>

                    <Label Text="Опис" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" Margin="0,10,0,0"/>
                    <Frame Padding="10,5" BorderColor="{StaticResource BorderColor}" CornerRadius="8" BackgroundColor="#F9F9F9" HasShadow="False">
                        <Editor Text="{Binding Description}" HeightRequest="100" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent" />
                    </Frame>

                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="{StaticResource CardBackground}" 
                   BorderColor="{StaticResource BorderColor}" 
                   CornerRadius="16" HasShadow="True" Padding="20">
                <VerticalStackLayout Spacing="15">

                    <Label Text="⚙️ ПАРАМЕТРИ" FontSize="12" CharacterSpacing="1" FontAttributes="Bold" TextColor="{StaticResource ThemeGoldenrod}" Margin="0,0,0,5" />

                    <Label Text="📌 Пріоритет" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" />
                    <Frame Padding="10,0" BorderColor="{StaticResource BorderColor}" CornerRadius="8" BackgroundColor="#F9F9F9" HasShadow="False">
                        <Picker Title="Змінити пріоритет"
                                ItemsSource="{Binding Priorities}"
                                SelectedItem="{Binding SelectedPriority}"
                                ItemDisplayBinding="{Binding DisplayName}"
                                TextColor="{StaticResource TextPrimary}"
                                BackgroundColor="Transparent" />
                    </Frame>

                    <Label Text="📅 Виконати до" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" Margin="0,10,0,0"/>
                    <Frame Padding="10,0" BorderColor="{StaticResource BorderColor}" CornerRadius="8" BackgroundColor="#F9F9F9" HasShadow="False">
                        <DatePicker Date="{Binding DueDate}" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent" />
                    </Frame>

                    <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" Margin="0,15" />

                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <CheckBox IsChecked="{Binding IsCompleted}" Color="{StaticResource SuccessColor}" />
                        <Label Text="Завдання виконано" VerticalOptions="Center" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,10,0,20">
                <Button Grid.Column="0" Text="Зберегти" 
                        Command="{Binding UpdateTaskCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="{StaticResource SuccessColor}"
                        TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="50" />

                <Button Grid.Column="1" Text="Скасувати" 
                        Command="{Binding CancelCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="{StaticResource DangerColor}"
                        TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="50" />
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" 
                               Color="{StaticResource ThemeGoldenrod}" HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>