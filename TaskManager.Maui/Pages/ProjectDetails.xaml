<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:KMA.TaskManager.Maui.ViewModels"
    xmlns:tasks="clr-namespace:KMA.TaskManager.Services.DTOModels.Tasks;assembly=TaskManager.DTOModels"
    x:Class="KMA.TaskManager.Maui.Pages.ProjectDetails"
    x:DataType="viewmodels:ProjectDetailsViewModel"
    BackgroundColor="{StaticResource PageBackground}"
    Title="Деталі проєкту">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Додати завдання" 
                     Command="{Binding CreateTaskCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Frame BackgroundColor="{StaticResource CardBackground}"
                   BorderColor="{StaticResource ThemeGoldenrod}"
                   CornerRadius="12" HasShadow="True" Padding="0" IsClippedToBounds="True">

                <VerticalStackLayout Spacing="0">
                    <BoxView HeightRequest="4" Color="{StaticResource ThemeGoldenrod}" VerticalOptions="Start"/>

                    <VerticalStackLayout Padding="20,15,20,15" Spacing="5">
                        <Label Text="{Binding CurrentProject.Name, StringFormat='ПРОЄКТ: {0}'}"
                               FontSize="22" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />

                        <Label Text="{Binding CurrentProject.ProjectType, Converter={StaticResource EnumToDisplayNameConverter}, StringFormat='Тип: {0}'}"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="14" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" />

                    <VerticalStackLayout Padding="20,15,20,15" Spacing="8">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Прогрес:" FontAttributes="Bold" VerticalOptions="Center" TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="{Binding CurrentProject.Progress, StringFormat='{0:F1}%'}"
                                   TextColor="{StaticResource ThemeCyan}" FontAttributes="Bold" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <ProgressBar Progress="{Binding CurrentProject.ProgressFraction}"
                                     ProgressColor="{StaticResource ThemeCyan}" HeightRequest="12" />

                        <Label Text="{Binding CurrentProject.ProgressStats}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" />

                    <VerticalStackLayout Padding="20,15,20,20" Spacing="8">
                        <Label Text="ОПИС" TextColor="{StaticResource ThemeGoldenrod}" FontSize="12" FontAttributes="Bold" />
                        <Label Text="{Binding CurrentProject.Description}" FontSize="16" TextColor="{StaticResource TextPrimary}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <Label Text="ЗАВДАННЯ ПРОЄКТУ" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource ThemeGoldenrod}" Margin="0,10,0,0" />

            <CollectionView ItemsSource="{Binding CurrentProject.Tasks}" SelectionMode="None" HeightRequest="400">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="tasks:TaskListDTO">
                        <Frame Margin="0,6" Padding="15" CornerRadius="10" BorderColor="{StaticResource BorderColor}"
                               BackgroundColor="{StaticResource CardBackground}" HasShadow="False">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProjectDetailsViewModel}}, Path=OpenTaskDetailsCommand}"
                                    CommandParameter="{Binding Id}" />
                            </Frame.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Label Grid.Column="0" FontSize="22" VerticalOptions="Center" Margin="0,0,15,0">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                            <Setter Property="Text" Value="✅" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="False">
                                            <Setter Property="Text" Value="⏳" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />

                                    <HorizontalStackLayout Spacing="5">
                                        <Label FontSize="12" FontAttributes="Bold">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Priority}" Value="Critical">
                                                    <Setter Property="Text" Value="Критичний" />
                                                    <Setter Property="TextColor" Value="{StaticResource DangerColor}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding Priority}" Value="High">
                                                    <Setter Property="Text" Value="Високий" />
                                                    <Setter Property="TextColor" Value="{StaticResource ThemeDarkPink}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding Priority}" Value="Medium">
                                                    <Setter Property="Text" Value="Середній" />
                                                    <Setter Property="TextColor" Value="{StaticResource ThemeCyan}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding Priority}" Value="Low">
                                                    <Setter Property="Text" Value="Низький" />
                                                    <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <Label Text="•" TextColor="Gray" VerticalOptions="Center" />
                                        <Label Text="{Binding DueDate, StringFormat='{0:dd.MM.yyyy}'}" FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <Label Grid.Column="2" VerticalOptions="Center" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource DangerColor}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsOverdue}" Value="True">
                                            <Setter Property="Text" Value="ПРОСТРОЧЕНО ⚠️" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsOverdue}" Value="False">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>