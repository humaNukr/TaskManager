<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:KMA.TaskManager.Maui.Tools.Converters"
             xmlns:vm="clr-namespace:KMA.TaskManager.Maui.ViewModels"
             x:Class="KMA.TaskManager.Maui.Pages.ProjectCreatePage"
             x:DataType="vm:ProjectCreateViewModel"
             Title="Створення проєкту">

    <ContentPage.Resources>
        <converters:EnumToDisplayNameConverter x:Key="EnumConverter" />
    </ContentPage.Resources>

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Назва проєкту *" FontAttributes="Bold" />
        <Entry Text="{Binding Name}" Placeholder="Введіть назву" />

        <Label Text="Опис" FontAttributes="Bold" />
        <Editor Text="{Binding Description}" Placeholder="Введіть опис" HeightRequest="100" />

        <Label Text="Тип проєкту" FontAttributes="Bold" />
        <Picker ItemsSource="{Binding ProjectTypes}"
                SelectedItem="{Binding SelectedProjectType}"
                ItemDisplayBinding="{Binding ., Converter={StaticResource EnumConverter}}" />

        <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
            <Button Grid.Column="0" Text="Скасувати" 
                    Command="{Binding CancelCommand}"
                    BackgroundColor="{StaticResource DangerColor}"
                    TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="50" />

            <Button Grid.Column="1" Text="Зберегти" 
                    Command="{Binding SaveCommand}"
                    TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="50">

                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsEnabled, Source={RelativeSource Self}}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource SuccessColor}" />
                    </DataTrigger>

                    <DataTrigger TargetType="Button" Binding="{Binding IsEnabled, Source={RelativeSource Self}}" Value="False">
                        <Setter Property="BackgroundColor" Value="LightGray" />
                    </DataTrigger>
                </Button.Triggers>

            </Button>
        </Grid>

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" 
                           Color="{StaticResource ThemeGoldenrod}" HorizontalOptions="Center" Margin="0,20,0,0" />

    </VerticalStackLayout>
</ContentPage>